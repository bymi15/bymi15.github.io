---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { site } from "../data/site";
import profile from "../assets/profile.jpg";
---

<section id="top" class="hero">
  <div class="backdrop" aria-hidden="true">
    <div class="dots"></div>
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="blob blob-c"></div>
  </div>

  <div class="container inner">
    <div class="text">
      <p class="location muted"><Icon name="pin" /> {site.location}</p>
      <h1>{site.name}</h1>
      <p class="title">{site.title}</p>
      <p class="pitch muted">{site.pitch}</p>
      <div class="actions">
        <a class="btn btn-primary" href={site.resumeUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="file" /> Resume
        </a>
        <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" /> LinkedIn
        </a>
        <a class="btn" href={site.links.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" /> GitHub
        </a>
      </div>
    </div>

    <div class="portrait">
      <div class="ring" aria-hidden="true"></div>
      <Image
        src={profile}
        alt={`Portrait of ${site.name}`}
        widths={[240, 480]}
        sizes="(min-width: 760px) 240px, 120px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 6rem 0 3rem;
  }

  /* ---------- Backdrop: dot grid + drifting glow ---------- */
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--fg) 16%, transparent) 1px, transparent 1.3px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 70% 65% at 70% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 65% at 70% 45%, #000 20%, transparent 75%);
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.32;
    will-change: transform;
  }
  :global([data-theme="dark"]) .blob { opacity: 0.22; }
  .blob-a { width: 26rem; height: 26rem; background: var(--accent); top: -6rem; right: 6%; }
  .blob-b { width: 20rem; height: 20rem; background: #8b5cf6; top: 8rem; right: 26%; }
  .blob-c { width: 18rem; height: 18rem; background: #14b8a6; top: 12rem; right: -4rem; }

  /* ---------- Layout ---------- */
  .inner { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 760px) {
    .inner { grid-template-columns: 1fr auto; gap: 3rem; }
  }

  .location { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.9375rem; margin-bottom: 1rem; }
  .location :global(svg) { width: 1rem; height: 1rem; }
  h1 { font-size: clamp(2.5rem, 7vw, 4rem); letter-spacing: -0.035em; font-weight: 700; }
  .title { font-size: clamp(1.15rem, 2.6vw, 1.4rem); font-weight: 500; margin-top: 0.75rem; }
  .pitch { max-width: 36rem; margin-top: 1rem; font-size: 1.0625rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  /* ---------- Portrait with gradient ring ---------- */
  .portrait {
    position: relative;
    width: 15rem;
    aspect-ratio: 1;
    justify-self: center;
  }
  .ring {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), #8b5cf6, #14b8a6, var(--accent));
  }
  .portrait :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 50%;
    border: 5px solid var(--bg);
  }

  @media (max-width: 759px) {
    .hero { padding-top: 3rem; }
    .portrait { width: 7.5rem; justify-self: start; order: -1; }
    .ring { inset: -3px; }
    .portrait :global(img) { border-width: 3px; }
    .blob-a { width: 18rem; height: 18rem; right: -6rem; }
    .blob-b { width: 14rem; height: 14rem; right: 30%; top: 4rem; }
    .blob-c { width: 12rem; height: 12rem; }
  }

  /* ---------- Motion (screen only, never when reduced motion is requested) ---------- */
  @media screen and (prefers-reduced-motion: no-preference) {
    .blob-a { animation: drift-a 22s ease-in-out infinite alternate; }
    .blob-b { animation: drift-b 26s ease-in-out infinite alternate; }
    .blob-c { animation: drift-c 30s ease-in-out infinite alternate; }
    .ring { animation: spin 14s linear infinite; }

    /* Entrance only when JS is running, so content is never stuck hidden. */
    :global(.js) .text > *,
    :global(.js) .portrait {
      animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    :global(.js) .text > :nth-child(2) { animation-delay: 0.08s; }
    :global(.js) .text > :nth-child(3) { animation-delay: 0.16s; }
    :global(.js) .text > :nth-child(4) { animation-delay: 0.24s; }
    :global(.js) .text > :nth-child(5) { animation-delay: 0.32s; }
    :global(.js) .portrait { animation-name: pop; animation-duration: 0.9s; animation-delay: 0.15s; }
  }

  @keyframes drift-a { to { transform: translate(-5rem, 3rem) scale(1.1); } }
  @keyframes drift-b { to { transform: translate(4rem, -2rem) scale(0.9); } }
  @keyframes drift-c { to { transform: translate(-3rem, -4rem) scale(1.15); } }
  @keyframes spin { to { transform: rotate(1turn); } }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  @keyframes pop { from { opacity: 0; transform: scale(0.94); } }
</style>
