---
import Section from "./Section.astro";
import { education } from "../data/education";
---

<Section id="education" title="Education">
  <ul class="list">
    {
      education.map((e) => (
        <li>
          <div>
            <h3>{e.degree}</h3>
            <p class="muted">{e.institution}</p>
            <p class="detail">{e.detail}</p>
          </div>
          <p class="muted year">{e.year}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  li { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .detail { font-size: 0.9375rem; margin-top: 0.25rem; }
  .year { flex: none; font-variant-numeric: tabular-nums; }
</style>
