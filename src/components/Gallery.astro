---
// One shared viewer for every [data-gallery] link on the page (see Projects.astro).
// Without JS those links simply open the large first image.
---

<dialog class="gallery" aria-labelledby="gallery-title">
  <div class="panel">
    <header>
      <h2 id="gallery-title"></h2>
      <form method="dialog">
        <button class="icon" aria-label="Close">×</button>
      </form>
    </header>
    <figure>
      <img alt="" decoding="async" />
    </figure>
    <footer>
      <button class="icon prev" type="button" aria-label="Previous screenshot">‹</button>
      <p class="counter muted" aria-live="polite"></p>
      <button class="icon next" type="button" aria-label="Next screenshot">›</button>
    </footer>
  </div>
</dialog>

<script>
  type GalleryItem = { src: string; srcset: string; alt: string };

  const dialog = document.querySelector<HTMLDialogElement>("dialog.gallery");
  const img = dialog?.querySelector("img");
  const title = dialog?.querySelector("h2");
  const counter = dialog?.querySelector(".counter");

  if (dialog && img && title && counter && typeof dialog.showModal === "function") {
    let items: GalleryItem[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      img.srcset = item.srcset;
      img.sizes = "(min-width: 1100px) 1000px, 100vw";
      img.src = item.src;
      img.alt = item.alt;
      counter.textContent = `${index + 1} / ${items.length}`;
    };

    document.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-gallery]");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      try {
        items = JSON.parse(link.dataset.gallery ?? "[]");
      } catch {
        return; // fall back to opening the image
      }
      if (!items.length) return;
      event.preventDefault();
      opener = link;
      title.textContent = link.dataset.galleryTitle ?? "";
      show(0);
      dialog.showModal();
    });

    dialog.querySelector(".prev")?.addEventListener("click", () => show(index - 1));
    dialog.querySelector(".next")?.addEventListener("click", () => show(index + 1));
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      else if (event.key === "ArrowRight") show(index + 1);
    });
    // A click on the dialog element itself is a click on the backdrop.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      img.removeAttribute("srcset");
      img.removeAttribute("src");
      opener?.focus();
    });
  }
</script>

<style>
  .gallery {
    width: min(1100px, 100vw - 2rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
  }
  .gallery::backdrop { background: color-mix(in srgb, var(--bg) 85%, transparent); }
  .panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem;
    display: grid;
    gap: 0.5rem;
  }
  header, footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  h2 { font-size: 1rem; font-weight: 600; padding-left: 0.5rem; overflow-wrap: anywhere; }
  figure { margin: 0; display: grid; place-items: center; background: var(--chip); border-radius: calc(var(--radius) - 4px); }
  img {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .counter { font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .icon {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    color: var(--fg);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .icon:hover { border-color: var(--accent); color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .gallery[open] { animation: gallery-in 150ms ease-out; }
    @keyframes gallery-in {
      from { opacity: 0; transform: scale(0.98); }
    }
  }
  @media print {
    .gallery { display: none; }
  }
</style>
