---
import { Image, getImage } from "astro:assets";
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import Gallery from "./Gallery.astro";
import { projects, moreProjects, type Shot } from "../data/projects";

export type GalleryItem = { src: string; srcset: string; alt: string; width: number; height: number };
type Trigger = { href: string; data: string; count: number };

/** Build-time viewer data for one project: WebP sources plus a no-JS fallback link. */
async function trigger(title: string, g?: Shot[]): Promise<Trigger | undefined> {
  if (!g?.length) return undefined;
  const items: GalleryItem[] = await Promise.all(
    g.map(async (src, i) => {
      const img = await getImage({ src, widths: [960, 1600], format: "webp" });
      return {
        src: img.src,
        srcset: img.srcSet.attribute,
        alt: `${title} screenshot ${i + 1} of ${g.length}`,
        width: src.width,
        height: src.height,
      };
    }),
  );
  const large = await getImage({ src: g[0], width: 1600, format: "webp" });
  return { href: large.src, data: JSON.stringify(items), count: g.length };
}

const cards = await Promise.all(projects.map(async (p) => ({ ...p, t: await trigger(p.title, p.gallery) })));
const more = await Promise.all(moreProjects.map(async (p) => ({ ...p, t: await trigger(p.title, p.gallery) })));
---

<Section id="work" title="Selected work">
  <div class="grid">
    {
      cards.map((p) => (
        <article class:list={["card", { featured: p.featured, "no-image": !p.gallery?.length }]}>
          {p.gallery?.[0] && p.t && (
            <a
              class="thumb"
              href={p.t.href}
              data-gallery={p.t.data}
              data-gallery-title={p.title}
              aria-label={`View ${p.t.count} screenshots of ${p.title}`}
            >
              <Image
                src={p.gallery[0]}
                alt={p.imageAlt ?? ""}
                widths={p.featured ? [640, 960, 1280] : [480, 720]}
                sizes={p.featured ? "(min-width: 720px) 560px, 100vw" : "(min-width: 720px) 440px, 100vw"}
                loading="lazy"
              />
              <span class="count" aria-hidden="true">⊞ {p.t.count}</span>
            </a>
          )}
          <div class="body">
            {p.featured && <p class="eyebrow">Featured</p>}
            <h3>
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                {p.title} <Icon name="arrow" />
              </a>
            </h3>
            <p class="muted desc">{p.description}</p>
            <ul class="chips">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            {p.extraLink && (
              <a class="extra" href={p.extraLink.url} target="_blank" rel="noopener noreferrer">
                {p.extraLink.label} →
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <details class="more">
    <summary>More projects ({moreProjects.length})</summary>
    <ul>
      {
        more.map((p) => (
          <li>
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                {p.title}
              </a>
            ) : (
              <span>{p.title}</span>
            )}
            <span class="meta">
              {p.t && (
                <a
                  class="shots"
                  href={p.t.href}
                  data-gallery={p.t.data}
                  data-gallery-title={p.title}
                  aria-label={`Screenshots of ${p.title}`}
                  title="Screenshots"
                >
                  ⊞ {p.t.count}
                </a>
              )}
              <span class="muted year">{p.year}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </details>
  <Gallery />
</Section>

<style>
  .grid { display: grid; gap: 1.25rem; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .thumb { display: block; position: relative; border-bottom: 1px solid var(--border); background: var(--chip); }
  .count {
    position: absolute; right: 0.75rem; bottom: 0.75rem;
    padding: 0.125rem 0.5rem; border: 1px solid var(--border); border-radius: 999px;
    background: var(--card); color: var(--fg); font-size: 0.75rem; font-weight: 500;
  }
  .thumb :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .body { padding: 1.25rem 1.375rem 1.375rem; display: flex; flex-direction: column; gap: 0.625rem; flex: 1; }
  .eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); font-weight: 600; }
  h3 a { color: var(--fg); display: inline-flex; align-items: center; gap: 0.375rem; }
  h3 a :global(svg) { width: 0.9em; height: 0.9em; color: var(--muted); }
  h3 { overflow-wrap: anywhere; }
  .desc { font-size: 0.9375rem; }
  .chips { margin-top: auto; padding-top: 0.25rem; }
  .extra { font-size: 0.9375rem; font-weight: 500; }
  .more { margin-top: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius); padding: 0.875rem 1.25rem; }
  .more summary { cursor: pointer; font-weight: 500; }
  .more ul { list-style: none; margin: 0.75rem 0 0.25rem; padding: 0; display: grid; gap: 0.5rem; }
  .more li { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9375rem; }
  .meta { display: inline-flex; align-items: baseline; gap: 0.875rem; flex: none; }
  .shots { font-size: 0.8125rem; font-weight: 500; white-space: nowrap; }
  .year { font-variant-numeric: tabular-nums; }
  @media (min-width: 720px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .featured { grid-column: 1 / -1; display: grid; grid-template-columns: 1.15fr 1fr; }
    .featured .thumb { border-bottom: 0; border-right: 1px solid var(--border); }
    .featured .thumb :global(img) { height: 100%; aspect-ratio: auto; }
    .featured .body { padding: 2rem; justify-content: center; }
    .featured h3 { font-size: 1.5rem; }
  }
</style>
