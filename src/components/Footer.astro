---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="muted">© {year} {site.name}</p>
    <ul>
      <li><a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: 2rem 0; font-size: 0.9375rem; }
  .inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
</style>
